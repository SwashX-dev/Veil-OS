#!/bin/sh

set -e
set -u
set -o pipefail

echo "Configuring Celluloid"

# The pair of "@@" arguments is required for `flatpak run`'s
# --file-forwarding option (see the flatpak-run(1) man page for
# details).
sed -i'' --regexp-extended \
    's,^Exec=celluloid\s.*$,Exec=/usr/local/bin/celluloid @@ %U @@,' \
    /usr/share/applications/io.github.celluloid_player.Celluloid.desktop
