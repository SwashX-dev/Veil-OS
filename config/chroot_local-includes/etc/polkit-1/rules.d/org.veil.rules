// Veil OS: let the logged-in live user start the two shutdown units without
// a password (an application could end the session anyway). Everything else
// falls back to the default authorization.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "veil-emergency-shutdown.service" ||
         action.lookup("unit") == "veil-session-failed.service") &&
        action.lookup("verb") == "start" &&
        subject.user == "amnesia" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
