#!/usr/bin/python3 -I
"""Apply Veil privacy settings in the running desktop session.

Started by veil-desktop-start. SIGHUP re-reads ~/.config/veil/privacy.json
(the Privacy Center and `veil privacy settings set` send it).

  * Idle lock: swayidle runs veil-autolock after N idle minutes.
  * Clipboard: wl-paste --watch reports every copy; N seconds after the last
    copy the clipboard and primary selection are cleared.
  * Camera/microphone: blocked devices are blocked again at login (blocking
    needs no password; unblocking does and is done by the Privacy Center).
  * Video upscaling: Celluloid gets the same mpv options as Veil Player.
"""

import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

from veil import media, privacy_settings

AUTOLOCK = "/usr/local/lib/veil/veil-autolock"
DEVICE_GUARD = "/usr/local/lib/veil/veil-device-guard"


class Daemon:
    def __init__(self) -> None:
        self.settings: dict = {}
        self.idle: subprocess.Popen | None = None
        self.watch: subprocess.Popen | None = None
        self.generation = 0
        self.timer: threading.Timer | None = None
        self.lock = threading.Lock()
        self.reload = threading.Event()
        self.stopping = threading.Event()
        self.copied = threading.Event()
        self.failures: dict[str, list[float]] = {"idle": [], "watch": []}

    # ------------------------------------------------------------ children
    def _may_restart(self, name: str) -> bool:
        """Allow at most 3 restarts of a helper per minute (no busy loops)."""
        now = time.monotonic()
        recent = [t for t in self.failures[name] if now - t < 60]
        self.failures[name] = recent + [now]
        if len(recent) >= 3:
            print(f"veil-privacy-daemon: {name} keeps failing; not restarting it", file=sys.stderr)
            return False
        return True

    @staticmethod
    def _stop(proc: subprocess.Popen | None) -> None:
        if proc and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()

    def _start_idle(self, minutes: int) -> None:
        self._stop(self.idle)
        self.idle = None
        if minutes > 0:
            self.idle = subprocess.Popen(["swayidle", "-w", "timeout", str(minutes * 60), AUTOLOCK],
                                         stdin=subprocess.DEVNULL)

    def _start_watch(self, seconds: int) -> None:
        self._stop(self.watch)
        self.watch = None
        if self.timer:
            self.timer.cancel()
        if seconds > 0:
            # CLIPBOARD_STATE (wl-clipboard >= 2.2) is "nil"/"clear" when the
            # selection was emptied, e.g. by us: that is not a new copy.
            notify = ('cat >/dev/null; case "${CLIPBOARD_STATE:-data}" in nil|clear) exit 0;; esac; '
                      f"kill -USR1 {os.getpid()}")
            self.watch = subprocess.Popen(["wl-paste", "--watch", "sh", "-c", notify],
                                          stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

    # ------------------------------------------------------------ clipboard
    def on_copy(self) -> None:
        seconds = self.settings.get("clipboard_clear_seconds", 0)
        with self.lock:
            self.generation += 1
            generation = self.generation
            if self.timer:
                self.timer.cancel()
            if seconds > 0:
                self.timer = threading.Timer(seconds, self.clear_clipboard, args=(generation,))
                self.timer.daemon = True
                self.timer.start()

    def clear_clipboard(self, generation: int) -> None:
        with self.lock:
            if generation != self.generation:
                return  # something newer was copied meanwhile
        for args in (["wl-copy", "--clear"], ["wl-copy", "--primary", "--clear"]):
            subprocess.run(args, check=False, stdin=subprocess.DEVNULL, timeout=10)

    # ------------------------------------------------------------ apply
    def apply(self) -> None:
        new = privacy_settings.load()
        old, first = self.settings, not self.settings
        self.settings = new
        if first or new["auto_lock_minutes"] != old.get("auto_lock_minutes"):
            self._start_idle(new["auto_lock_minutes"])
        elif self.idle and self.idle.poll() is not None and self._may_restart("idle"):
            self._start_idle(new["auto_lock_minutes"])
        if first or new["clipboard_clear_seconds"] != old.get("clipboard_clear_seconds"):
            self._start_watch(new["clipboard_clear_seconds"])
        elif self.watch and self.watch.poll() is not None and self._may_restart("watch"):
            self._start_watch(new["clipboard_clear_seconds"])
        for name in ("camera", "microphone"):
            key = f"{name}_blocked"
            if new[key] and (first or not old.get(key)):
                subprocess.run(["sudo", "-n", DEVICE_GUARD, "block", name], check=False,
                               stdout=subprocess.DEVNULL, timeout=60)
        if first or new["video_upscaling"] != old.get("video_upscaling"):
            media.sync_celluloid(new["video_upscaling"])

    def run(self) -> int:
        runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        pidfile = Path(runtime, "veil-privacy-daemon.pid")
        pidfile.write_text(f"{os.getpid()}\n")
        signal.signal(signal.SIGHUP, lambda *_: self.reload.set())
        signal.signal(signal.SIGUSR1, lambda *_: self.copied.set())
        signal.signal(signal.SIGTERM, lambda *_: self.stopping.set())
        signal.signal(signal.SIGINT, lambda *_: self.stopping.set())
        try:
            self.apply()
            while not self.stopping.is_set():
                self.stopping.wait(1.0)
                if self.copied.is_set():
                    self.copied.clear()
                    self.on_copy()
                if self.reload.is_set():
                    self.reload.clear()
                    self.apply()
                # Restart a helper that died (rate-limited in apply()).
                elif (self.idle and self.idle.poll() is not None) or (self.watch and self.watch.poll() is not None):
                    self.apply()
                    if self.idle and self.idle.poll() is not None and len(self.failures["idle"]) > 3:
                        self.idle = None
                    if self.watch and self.watch.poll() is not None and len(self.failures["watch"]) > 3:
                        self.watch = None
        finally:
            self._stop(self.idle)
            self._stop(self.watch)
            if self.timer:
                self.timer.cancel()
            try:
                if pidfile.read_text().strip() == str(os.getpid()):
                    pidfile.unlink()
            except OSError:
                pass
        return 0


if __name__ == "__main__":
    sys.exit(Daemon().run())
