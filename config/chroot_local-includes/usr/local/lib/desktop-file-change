#!/usr/bin/python3

"""
This script is meant to do simple operations with desktop files
"""

import argparse
import sys
from configparser import ConfigParser

DEFAULT_SECTION = "Desktop Entry"


class DesktopChanger:
    def __init__(self):
        self.parser = self.get_parser()

    def get_parser(self):
        p = argparse.ArgumentParser()
        p.set_defaults(func=None, type_=None)
        p.add_argument("--file")
        p.add_argument(
            "--dry-run",
            action="store_true",
            default=False,
            help="Don't really modify, just print to output",
        )
        sub = p.add_subparsers()

        get = sub.add_parser("get")
        get.set_defaults(func=self.main_get)
        get.add_argument("--section", default=DEFAULT_SECTION)
        get.add_argument("key")

        set_ = sub.add_parser("set")
        set_.set_defaults(func=self.main_set, type_="filter")
        set_.add_argument("--section", default=DEFAULT_SECTION)
        set_.add_argument("key")
        set_.add_argument("value")

        del_section = sub.add_parser("delete-section")
        del_section.set_defaults(func=self.main_del_section, type_="filter")
        del_section.add_argument("section")

        import_section = sub.add_parser(
            "import-section",
            help="Import a section from another file",
        )
        import_section.set_defaults(func=self.main_import_section, type_="filter")
        import_section.add_argument("section")
        import_section.add_argument("otherfile")

        return p

    def main(self):
        self.args = self.parser.parse_args()
        if not self.args.func:
            self.parser.print_help()
            sys.exit(2)

        self.data = self.load(self.args.file)
        self.args.func()

        if self.args.type_ == "filter":
            # Those subcommands are filters, so they share lot of functionalities
            if self.args.dry_run:
                self.data.write(sys.stdout, space_around_delimiters=False)
            else:
                with open(self.args.file, "w") as buf:
                    self.data.write(buf, space_around_delimiters=False)

    def main_get(self):
        if self.args.section not in self.data.sections():
            print("Section not found", file=sys.stderr)
            sys.exit(1)
            return
        value = self.data[self.args.section][self.args.key]
        print(value)

    def main_set(self):
        if self.args.section not in self.data.sections():
            self.data.add_section(self.args.section)
        self.data[self.args.section][self.args.key] = self.args.value

    def main_del_section(self):
        self.data.remove_section(self.args.section)

    def main_import_section(self):
        otherdata = self.load(self.args.otherfile)

        self.data.remove_section(self.args.section)
        self.data.add_section(self.args.section)
        for key in otherdata[self.args.section]:
            self.data[self.args.section][key] = otherdata[self.args.section][key]

    def load(self, filepath):
        if filepath == "-":
            input_contents = sys.stdin.read()
        else:
            with open(filepath) as buf:
                input_contents = buf.read()

        data = ConfigParser(interpolation=None, strict=False)
        # otherwise, ConfigParser converts to lowercase
        data.optionxform = lambda option: option
        data.read_string(input_contents)
        return data


if __name__ == "__main__":
    DesktopChanger().main()
