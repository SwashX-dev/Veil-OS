#!/bin/sh

set -eu -o pipefail

# Get LIVE_USERNAME
. /etc/live/config.d/username.conf

# By default this directory will be owned by root an not writable by
# the live user, but the live user must be able to write to
# flatpak/org.gnome.software.dconf-dump (see
# /usr/local/lib/tails-persist-gnome-software-dconf-state).
mkdir -p /live/persistence/TailsData_unlocked/flatpak
chown "${LIVE_USERNAME}:${LIVE_USERNAME}" /live/persistence/TailsData_unlocked/flatpak
