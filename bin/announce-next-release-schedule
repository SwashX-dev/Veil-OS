#!/bin/sh

set -eu
set -o pipefail

NEXT_PLANNED_VERSION="$1"

./bin/automailer.py <<EOF
To: tails-dev@lists.torproject.org,tails-l10n@lists.torproject.org
Subject: Release schedule for Tails ${NEXT_PLANNED_VERSION:?}

Hi,

XXX will be the RM for Tails ${NEXT_PLANNED_VERSION:?},
which we'll release between Tuesday XXX and Thursday XXX.

EOF
