#!/usr/bin/python3

import argparse
import os
import subprocess
import sys


class ParsingError(Exception):
    """Raised when failing to read or parse sysfs CPU range data."""


def parse_cpu_range_count(sysfs_path):
    """Parses Linux CPU list format (e.g., '0-3,5,7-9') read from sysfs_path and returns total count."""
    with open(sysfs_path) as f:
        content = f.read().strip()
    if not content:
        raise ParsingError(f"File {sysfs_path} is empty")

    count = 0
    for _part in content.split(","):
        part = _part.strip()
        if "-" in part:
            start, end = (int(p) for p in part.split("-"))
            count += end - start + 1
        elif part.isdigit():
            count += 1
        else:
            raise ParsingError(f"Invalid segment: '{part}'")
    return count


def get_guess_concurrency(mem_val):
    """Executes guess_concurrency and returns integer output."""
    return int(
        subprocess.check_output(
            ["/bin/guess_concurrency", "--require-mem", mem_val],
            text=True,
        ).strip()
    )


def main():
    parser = argparse.ArgumentParser(
        description="Determine maximum concurrency based on memory constraints and available performance cores."
    )
    parser.add_argument(
        "--require-mem",
        required=True,
        help="Memory specification (e.g., '3G')",
    )
    args = parser.parse_args()

    # 1. Get constraint from guess_concurrency output
    guess_val = get_guess_concurrency(args.require_mem)
    candidates = [guess_val]

    # 2. Get constraint from "performance cores" count if sysfs path exists
    sysfs_path = "/sys/devices/cpu_core/cpus"
    if os.path.exists(sysfs_path):
        p_cores = parse_cpu_range_count(sysfs_path)
        candidates.append(p_cores)

    # Output the minimum value, so we never exceed any of our constraints
    print(min(candidates))


if __name__ == "__main__":
    main()
