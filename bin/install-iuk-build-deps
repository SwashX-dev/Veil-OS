#!/bin/sh

set -eu -o pipefail

grep -E -v '^#' "$(git rev-parse --show-toplevel)"/config/chroot_local-packageslists/tails-iuk.list |
    xargs sudo apt --yes install

sudo apt install \
    libdist-zilla-plugin-test-notabs-perl \
    libdist-zilla-plugin-test-perl-critic-perl \
    libdist-zilla-app-command-authordebs-perl \
    libtest-lwp-useragent-perl

# The previous `apt install` installs `apt-file` (by way of transitive
# dependencies), which configures APT to download additional APT
# lists, which are needed by `dzil authordebs --install`. To honor
# this updated APT configuration and download these APT lists, we need
# to run `apt update`:
sudo apt update

cd "$(git rev-parse --show-toplevel)/config/chroot_local-includes/usr/src/iuk"
dzil authordebs --install

sudo apt install \
    libarchive-tools \
    libdevice-cdio-perl \
    dosfstools \
    faketime \
    gdisk \
    genisoimage \
    gnutls-bin \
    kpartx \
    libdata-dumper-concise-perl \
    libdatetime-perl \
    libfile-copy-recursive-perl \
    nginx \
    python3-xattr \
    squashfs-tools-ng=1.3.2-1 \
    syslinux
