#!/bin/bash

set -eu
set -o pipefail

VERSION="${1}"
IUKS_HASHES="${1}"

ssh jenkins.mtl-libvirt-02 <<EOF | grep -E '[.]iuk$' >"jenkins_${VERSION}.sha256sum"
find /var/lib/jenkins/jobs/ -name '*.iuk' -mtime -1 -exec sha256sum {} \;
EOF
sed -i 's@/.*/Tails_@Tails_@' "jenkins_${VERSION}.sha256sum"
diff <(sort "jenkins_${VERSION}.sha256sum") <(sort "${IUKS_HASHES:?}")
rm "jenkins_${VERSION}.sha256sum"
