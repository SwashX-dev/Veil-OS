#!/bin/bash

set -eu

TBB_VERSION="$1"

typeset -a tbbUrls
tbbUrls=('https://archive.torproject.org/tor-package-archive/torbrowser/?C=M;O=D' 'https://www.torproject.org/dist/torbrowser/?C=M;O=D' 'https://people.torproject.org/~'{boklm,ma1,morgan,pierov}'/builds/?C=M;O=D')
for i in $(seq --equal-width 1 20); do
    buildserver="tb-build-${i}.torproject.org"
    if host "$buildserver" &>/dev/null; then
        tbbUrls+=("https://${buildserver}/~"{boklm,ma1,morgan,pierov}'/builds/torbrowser/release/unsigned/')
    fi
done
echo "Scanning " "${tbbUrls[@]}"
while true; do
    if (
        for u in "${tbbUrls[@]}"; do
            echo "query ${u}" >&2
            elinks -no-numbering -dump "$u" | sed -e "s+^+[${u//+/ }]+"
        done
    ) | grep -F -e "${TBB_VERSION?}" -e "$(date +%F)" -e "$(date +%F -d yesterday)" --color=always; then
        echo FOUND
        notify-send "Found Tor Browser tarball"
    fi
    sleep 10m
done
